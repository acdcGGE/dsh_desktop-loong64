/artifacts/

# ===== 第三方参考仓库（仅本地参考，不入库）=====
/reference-repo/

# ===== 编辑器 / 系统临时 =====
.DS_Store
*~
*.swp

# ===== 会话级临时脚本（非仓库内容）=====
/build-rc*.sh
/resume*.sh
/finalize*.sh
/fetch-runtime-assets.sh

# ===== 构建机本地库缓存（由 resolve-runtime-libs.py 生成，非源码）=====
/blas-libs/
